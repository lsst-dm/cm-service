#!/usr/bin/env bash
set -e
{# BLANK LINE #}
{#- PHASE: HEADER =========================================================== #}
export CM_TIMESTAMP="$(date '+%Y%m%dT%H%M%SZ')"
{%- if lsst.environment %}
{%- for key, value in lsst.environment|items %}
export {{ key }}="{{ value }}"
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{% if site.botocore_config_file %}export AWS_CONFIG_FILE="{{site.botocore_config_file}}"{% endif %}
{% if site.botocore_credentials_file %}export AWS_SHARED_CREDENTIALS_FILE="{{site.botocore_credentials_file}}"{% endif %}
{% if site.lsst_db_auth_file %}export LSST_DB_AUTH="{{site.lsst_db_auth_file}}"{% endif %}
{% if site.lsst_data_repos_file %}export DAF_BUTLER_REPOSITORY_INDEX="{{site.lsst_data_repos_file}}"{% endif %}
{# BLANK LINE #}
{%- if lsst.prepend %}
{%- for line in lsst.prepend %}
{{ line | shlex }}
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{%- if lsst.launcher %}
{#- PHASE: LAUNCHER LSST SETUP ============================================== #}
{%- for line in lsst.launcher %}
{{ line | shlex }}
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{%- if lsst.custom_lsst_setup %}
{%- for line in lsst.custom_lsst_setup %}
{{ line | shlex }}
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{#- PHASE: WMS SETUP ======================================================== #}
{%- if wms.environment %}
{%- for key, value in wms.environment|items %}
export {{ key }}="{{ value }}"
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{%- if wms.custom_setup %}
{%- for line in wms.custom_setup %}
{{ line | shlex }}
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{#- PHASE: PAYLOAD COMMANDS ================================================= #}
{%- if lsst.custom_payload %}
{%- for line in lsst.custom_payload %}
{{ line | shlex }}
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
{%- for command in lsst.command %}
{{ command | shlex }}
{# BLANK LINE #}
{%- endfor %}
{#- PHASE: POSTFLIGHT TRAILER =============================================== #}
{%- if lsst.append %}
{%- for line in lsst.append %}
{{ line | shlex }}
{%- endfor %}
{# BLANK LINE #}
{%- endif %}
